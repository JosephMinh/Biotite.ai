---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
---

<Base
  title="Contact — Biotite Solutions"
  description="Book an introductory call with Biotite Solutions to discuss the workflow, data, or system you want AI to handle properly."
>
  <section class="section wrap">
    <div class="split">
      <div>
        <p class="eyebrow" data-reveal>Contact</p>
        <h1 class="t-display t-2xl contact-title" data-reveal style="--reveal-delay:.06s">
          Start with the problem,<br />not the <em>technology</em>
        </h1>
      </div>
      <div>
        <p class="t-lg t-body" data-reveal>
          Bring us the workflow that eats your team's week, the data nobody
          can query, or the process you suspect AI could carry. In thirty
          minutes we'll tell you honestly whether we can help — and if we
          can't, we'll say so.
        </p>

        <div class="contact-card" data-reveal>
          <p class="t-mono contact-card__label">Primary route</p>
          <h2 class="t-display t-xl">Introductory call</h2>
          <p class="contact-card__desc">
            Thirty minutes, no preparation required. If there's a fit, we
            follow up with a concrete working plan for your goals.
          </p>
          <a href={site.calendly} class="btn btn--solid" rel="noopener">
            <span>Book on Calendly</span>
          </a>
        </div>

        <dl class="contact-alt" data-reveal>
          <div class="fact">
            <dt>LinkedIn</dt>
            <dd>
              <a href={site.social.linkedin} class="link-inline" rel="noopener">
                linkedin.com/in/joesamara
              </a>
            </dd>
          </div>
          <div class="fact">
            <dt>YouTube</dt>
            <dd>
              <a href={site.social.youtube} class="link-inline" rel="noopener">
                youtube.com/@Joe-Samara
              </a>
            </dd>
          </div>
        </dl>

        <div class="contact-expect" data-reveal>
          <h2 class="t-mono contact-expect__title">What happens next</h2>
          <ol class="contact-expect__list">
            <li>We talk through your problem and current systems.</li>
            <li>We tell you plainly whether Biotite is the right fit.</li>
            <li>
              If it is, you receive a concrete plan: scope, integration
              points, and how we'll measure that the system works.
            </li>
          </ol>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-title {
    max-width: 12em;
  }

  .contact-card {
    margin-top: var(--space-block);
    border: 1px solid var(--c-line);
    border-radius: 3px;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    display: grid;
    gap: 1rem;
    justify-items: start;
    background:
      radial-gradient(120% 140% at 85% -20%, rgba(100, 0, 0, 0.18), transparent 55%),
      var(--c-bg-raised);
  }

  .contact-card__label {
    color: var(--c-garnet-bright);
  }

  .contact-card__desc {
    color: var(--c-silver);
    max-width: 34em;
  }

  .contact-card .btn {
    margin-top: 0.5rem;
  }

  .contact-alt {
    display: grid;
    gap: 1.75rem;
    margin: var(--space-block) 0 0;
  }

  @media (min-width: 40rem) {
    .contact-alt {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-expect {
    margin-top: var(--space-block);
    border-top: 1px solid var(--c-line);
    padding-top: 1.5rem;
  }

  .contact-expect__title {
    color: var(--c-faint);
  }

  .contact-expect__list {
    margin: 1.25rem 0 0;
    padding-left: 1.2em;
    color: var(--c-silver);
    display: grid;
    gap: 0.6rem;
    max-width: 38em;
  }
</style>
