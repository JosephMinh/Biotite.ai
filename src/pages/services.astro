---
import Base from "../layouts/Base.astro";
import { services, process, site } from "../data/site";
---

<Base
  title="Services — Biotite Solutions"
  description="Custom AI agents, RAG and knowledge systems, computer vision pipelines, internal applications, data integrations, and AI enablement — engineered as production systems by Biotite Solutions."
>
  <section class="section wrap">
    <header class="svc-head">
      <p class="eyebrow" data-reveal>Services</p>
      <h1 class="t-display t-2xl" data-reveal style="--reveal-delay:.06s">
        Six capabilities.<br />One discipline: <em>systems that ship.</em>
      </h1>
      <p class="t-lg t-body svc-head__sub" data-reveal style="--reveal-delay:.12s">
        Every service below ends in working, integrated software — designed
        around your workflows, evaluated against your data, and run in your
        environment.
      </p>
    </header>
  </section>

  <section class="wrap" aria-label="Service details">
    {services.map((svc, i) => (
      <article class="section section--hairline svc-detail" id={svc.id}>
        <div class="split">
          <div>
            <p class="numeral" data-reveal>{String(i + 1).padStart(2, "0")}</p>
            <h2 class="t-display t-xl svc-detail__title" data-reveal>{svc.title}</h2>
          </div>
          <div>
            <p class="t-lg svc-detail__summary" data-reveal>{svc.summary}</p>
            <p class="t-body svc-detail__body" data-reveal>{svc.detail}</p>
            {svc.proofSlug && (
              <a class="link-arrow svc-detail__proof" href={`/work/${svc.proofSlug}/`} data-reveal>
                {svc.proofLabel}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="section section--hairline wrap">
    <div class="split">
      <div>
        <p class="eyebrow" data-reveal>Engagement</p>
        <h2 class="t-display t-2xl" data-reveal style="--reveal-delay:.06s">How an engagement runs</h2>
      </div>
      <ol class="eng-list">
        {process.map((stage) => (
          <li class="eng-stage" data-reveal>
            <span class="numeral">{stage.index}</span>
            <div>
              <h3 class="t-lg">{stage.title}</h3>
              <p>{stage.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div class="eng-cta" data-reveal>
      <a href={site.calendly} class="btn btn--solid" rel="noopener"><span>Book an intro call</span></a>
    </div>
  </section>
</Base>

<style>
  .svc-head {
    display: grid;
    gap: 1.4rem;
  }

  .svc-head__sub {
    max-width: 34em;
  }

  .svc-detail__title {
    margin-top: 0.75rem;
    max-width: 12em;
  }

  .svc-detail__summary {
    max-width: 30em;
  }

  .svc-detail__body {
    margin-top: 1.25rem;
  }

  .svc-detail__proof {
    margin-top: 1.5rem;
  }

  .eng-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .eng-stage {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding-block: 1.6rem;
    border-top: 1px solid var(--c-line);
  }

  .eng-stage:first-child {
    border-top: none;
    padding-top: 0;
  }

  .eng-stage p {
    margin-top: 0.5rem;
    color: var(--c-silver);
    max-width: 36em;
  }

  .eng-cta {
    margin-top: var(--space-block);
  }
</style>
