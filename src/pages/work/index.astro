---
import Base from "../../layouts/Base.astro";
import CaseCard from "../../components/CaseCard.astro";
import { caseStudies } from "../../data/caseStudies";

const industries = [...new Set(caseStudies.map((c) => c.industry))];
---

<Base
  title="Work — Biotite Solutions"
  description="Case studies from Biotite Solutions: custom AI agents, retrieval systems, vision pipelines, and decision-support applications built for biotech, technology, and manufacturing companies."
>
  <section class="section wrap">
    <header class="work-head">
      <p class="eyebrow" data-reveal>Work</p>
      <h1 class="t-display t-2xl" data-reveal style="--reveal-delay:.06s">
        Systems that earned<br />their place in <em>operation</em>
      </h1>
      <p class="t-body t-lg work-head__sub" data-reveal style="--reveal-delay:.12s">
        Client names are shared in conversation, not on the open web. Each
        study below describes the problem, the system we built, and what
        changed — in the client's terms, not ours.
      </p>
    </header>

    <div class="work-filter" data-reveal role="group" aria-label="Filter case studies by industry">
      <button class="work-filter__btn is-active" data-filter="all" type="button">All</button>
      {industries.map((ind) => (
        <button class="work-filter__btn" data-filter={ind} type="button">{ind}</button>
      ))}
    </div>

    <div class="work-list" data-work-list>
      {caseStudies.map((study, i) => (
        <div data-industry={study.industry}>
          <CaseCard study={study} index={i} />
        </div>
      ))}
    </div>
  </section>

  <script>
    // Understated industry filter; plain buttons, no URL state needed at
    // this catalogue size.
    const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
    const items = document.querySelectorAll<HTMLElement>("[data-industry]");
    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        buttons.forEach((b) => b.classList.toggle("is-active", b === btn));
        const value = btn.dataset.filter;
        items.forEach((item) => {
          item.hidden = value !== "all" && item.dataset.industry !== value;
        });
      });
    });
  </script>
</Base>

<style>
  .work-head {
    display: grid;
    gap: 1.4rem;
    margin-bottom: var(--space-block);
  }

  .work-head__sub {
    max-width: 34em;
  }

  .work-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .work-filter__btn {
    padding: 0.45rem 1rem;
    background: none;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-silver);
    cursor: pointer;
    transition: color 0.3s, border-color 0.3s;
  }

  .work-filter__btn:hover {
    color: var(--c-porcelain);
    border-color: var(--c-line-strong);
  }

  .work-filter__btn.is-active {
    color: var(--c-porcelain);
    border-color: var(--c-garnet-bright);
  }
</style>
