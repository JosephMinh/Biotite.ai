---
import Base from "../layouts/Base.astro";
import CaseCard from "../components/CaseCard.astro";
import { featuredCaseStudies } from "../data/caseStudies";
import { services, process, site } from "../data/site";

const homeServices = services.filter((s) => s.id !== "enablement");
---

<Base
  title="Biotite Solutions — Custom AI systems, engineered for production"
  description={site.description}
  bare
>
  <!-- Signature visual: one persistent canvas, enhanced progressively.
       The static poster below is the no-WebGL / reduced-motion fallback. -->
  <div class="experience" aria-hidden="true" data-experience>
    <div class="experience__poster" data-poster>
      <picture class="experience__poster-picture">
        <source
          media="(max-width: 60rem)"
          srcset="/core-poster-mobile.webp"
        />
        <img
          src="/core-poster-desktop.webp"
          alt=""
          width="1920"
          height="1200"
          decoding="async"
          fetchpriority="high"
          class="experience__poster-image"
        />
      </picture>
    </div>
  </div>

  <!-- Section progress rail: six sheets echoing the mark. Decorative;
       real navigation lives in the header. -->
  <div class="rail" aria-hidden="true" data-rail>
    {["hero", "positioning", "work", "services", "process", "about"].map((id) => (
      <span class="rail__sheet" data-rail-sheet={id}></span>
    ))}
  </div>

  <!-- ===================== Opening fly-through ====================
       Pure scroll stage for the WebGL intro: the artifact alone, full
       screen; scrolling carries the camera through the cleaved layers
       into the site. Hidden entirely unless the WebGL core is running
       (html.has-core is set by the scene on successful mount), so
       reduced-motion, no-JS, and no-WebGL visitors land directly on
       the hero. -->
  <div class="intro" data-intro aria-hidden="true">
    <p class="intro__cue t-mono">Scroll to enter</p>
  </div>

  <!-- ============================ Hero ============================ -->
  <section class="hero wrap" data-section="hero">
    <div class="hero__content">
      <p class="eyebrow" data-reveal>Custom AI systems studio</p>
      <h1 class="t-display t-hero hero__title" data-reveal style="--reveal-delay: 0.08s">
        We engineer AI systems<br />that <em>hold up</em> in production.
      </h1>
      <p class="t-lg t-body hero__sub" data-reveal style="--reveal-delay: 0.16s">
        Biotite Solutions designs and builds custom agents, knowledge systems,
        and decision-support tools for businesses whose workflows, data, and
        software are too specific for off-the-shelf AI.
      </p>
      <div class="hero__actions" data-reveal style="--reveal-delay: 0.24s">
        <a href={site.calendly} class="btn btn--solid" rel="noopener"><span>Book an intro call</span></a>
        <a href="/work/" class="btn"><span>See the work</span></a>
      </div>
    </div>
    <div class="hero__foot" data-reveal style="--reveal-delay: 0.4s">
      <p class="t-mono hero__foot-list">
        Agents&ensp;·&ensp;Knowledge systems&ensp;·&ensp;Vision pipelines&ensp;·&ensp;Internal applications
      </p>
      <p class="t-mono hero__foot-scroll">Scroll</p>
    </div>
  </section>

  <!-- ======================= Positioning ========================= -->
  <section class="section wrap" data-section="positioning">
    <span class="sec-mark t-mono" aria-hidden="true">Sec. 01 / 05</span>
    <div class="split">
      <p class="eyebrow" data-reveal>What we do</p>
      <div>
        <p class="t-display t-xl statement" data-reveal>
          Most AI initiatives stall between the demo and the day-to-day. We
          exist for that gap: complete systems — models, agent logic, your
          proprietary data, integrations, backend, and interface —
          <em>built as one piece of working software.</em>
        </p>
        <div class="statement__facts" data-reveal>
          <dl class="fact">
            <dt>Built for</dt>
            <dd>SMB leadership teams with complex or specialized workflows</dd>
          </dl>
          <dl class="fact">
            <dt>Experience in</dt>
            <dd>Biotech, technology, and manufacturing organizations</dd>
          </dl>
          <dl class="fact">
            <dt>Engagements</dt>
            <dd>Typically 3–6 months; minimum six weeks</dd>
          </dl>
        </div>
        <div class="system-anatomy" data-reveal>
          <div class="system-anatomy__intro">
            <p class="t-mono system-anatomy__label">System anatomy</p>
            <p>
              The exact stack changes with the problem. The discipline does
              not: every relevant layer is engineered as part of the same
              working system.
            </p>
          </div>
          <ol class="system-stack" aria-label="Layers of a production AI system">
            {[
              "Interface",
              "Backend",
              "Integrations",
              "Agent logic",
              "Model behavior",
              "Proprietary data",
            ].map((layer, i) => (
              <li style={`--layer-index:${i}`}>
                <span class="numeral">{String(6 - i).padStart(2, "0")}</span>
                <span>{layer}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================== Selected work ======================= -->
  <section class="section section--hairline wrap" data-section="work">
    <span class="sec-mark t-mono" aria-hidden="true">Sec. 02 / 05</span>
    <div class="section-head" data-reveal>
      <p class="eyebrow">Selected work</p>
      <h2 class="t-display t-2xl">Systems in service</h2>
    </div>
    <div class="work-list">
      {featuredCaseStudies.map((study, i) => (
        <CaseCard study={study} index={i} />
      ))}
    </div>
    <div class="section-foot" data-reveal>
      <a href="/work/" class="link-arrow">
        All case studies
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ========================== Services ========================== -->
  <section class="section section--hairline wrap" data-section="services">
    <span class="sec-mark t-mono" aria-hidden="true">Sec. 03 / 05</span>
    <div class="section-head" data-reveal>
      <p class="eyebrow">Capabilities</p>
      <h2 class="t-display t-2xl">What we build</h2>
    </div>
    <ul class="svc-list">
      {homeServices.map((svc, i) => (
        <li class="svc" data-reveal>
          <span class="numeral svc__num">{String(i + 1).padStart(2, "0")}</span>
          <div class="svc__body">
            <h3 class="t-xl t-display">{svc.title}</h3>
            <p class="svc__summary">{svc.summary}</p>
            {svc.proofSlug && (
              <a class="svc__proof" href={`/work/${svc.proofSlug}/`}>
                <span class="t-mono">Proof</span>
                {svc.proofLabel}
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
    <div class="section-foot" data-reveal>
      <a href="/services/" class="link-arrow">
        Services in detail
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- =========================== Process =========================== -->
  <section class="section section--hairline wrap" data-section="process">
    <span class="sec-mark t-mono" aria-hidden="true">Sec. 04 / 05</span>
    <div class="split">
      <div>
        <p class="eyebrow" data-reveal>How we work</p>
        <h2 class="t-display t-2xl" data-reveal style="--reveal-delay:.06s">From first call<br />to running system</h2>
        <p class="t-body process__intro" data-reveal style="--reveal-delay:.12s">
          No discovery theater, no fifty-page strategy deck. A short path to
          working software, with checkpoints where you decide whether to
          continue.
        </p>
      </div>
      <ol class="process-list">
        {process.map((stage) => (
          <li class="process-stage" data-reveal>
            <span class="numeral">{stage.index}</span>
            <div>
              <h3 class="t-lg process-stage__title">{stage.title}</h3>
            <p class="process-stage__desc">{stage.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============================ About ============================ -->
  <section class="section section--hairline wrap" data-section="about">
    <span class="sec-mark t-mono" aria-hidden="true">Sec. 05 / 05</span>
    <div class="split">
      <p class="eyebrow" data-reveal>Point of view</p>
      <div>
        <p class="t-display t-xl statement" data-reveal>
          The name comes from a mineral that forms in <em>clean, distinct
          layers</em>. That's how we build: data, logic, and interface each
          engineered properly — never a thin demo over an API call.
        </p>
        <ul class="principles">
          <li class="principle" data-reveal>
            <h3 class="t-lg">Working systems, not prototypes</h3>
            <p>Every engagement ends in software that runs in your business — evaluated, documented, and maintained.</p>
          </li>
          <li class="principle" data-reveal>
            <h3 class="t-lg">Humans stay in charge</h3>
            <p>We design explicit review points and audit trails, so automation extends your team's judgment instead of replacing it.</p>
          </li>
          <li class="principle" data-reveal>
            <h3 class="t-lg">Until it works</h3>
            <p>We don't consider a system delivered because a contract says so. We work until it earns its place in your operation.</p>
          </li>
        </ul>
        <div class="section-foot" data-reveal>
          <a href="/about/" class="link-arrow">
            About Biotite
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { mountExperience } from "../scripts/experience";
    mountExperience();

    // Progress rail: highlight the sheet of the section in view.
    const sheets = new Map<string, HTMLElement>();
    document
      .querySelectorAll<HTMLElement>("[data-rail-sheet]")
      .forEach((el) => sheets.set(el.dataset.railSheet!, el));
    const sections = document.querySelectorAll<HTMLElement>("[data-section]");
    // During the opening fly-through no section crosses the observer band,
    // so light the first sheet until real sections take over.
    sheets.get("hero")?.classList.add("is-active");
    if ("IntersectionObserver" in window && sheets.size) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const id = (entry.target as HTMLElement).dataset.section!;
              sheets.forEach((el, key) =>
                el.classList.toggle("is-active", key === id)
              );
            }
          }
        },
        { rootMargin: "-45% 0px -45% 0px" }
      );
      sections.forEach((s) => io.observe(s));
    }
  </script>
</Base>

<style>
  /* Canvas / poster layer */
  .experience {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    /* Baseline atmosphere shown before/without WebGL. */
    background:
      radial-gradient(60% 55% at 68% 52%, rgba(90, 16, 4, 0.28), transparent 70%),
      radial-gradient(50% 40% at 55% 20%, rgba(30, 40, 32, 0.35), transparent 75%),
      linear-gradient(180deg, #030403 0%, #060906 55%, #020402 100%);
  }

  @media (max-width: 60rem) {
    .experience {
      background:
        radial-gradient(70% 40% at 50% 30%, rgba(90, 16, 4, 0.22), transparent 70%),
        linear-gradient(180deg, #030403 0%, #060906 55%, #020402 100%);
    }
  }

  /* Progress rail */
  .rail {
    position: fixed;
    right: clamp(1rem, 2.5vw, 2.4rem);
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: grid;
    gap: 9px;
    pointer-events: none;
  }

  @media (max-width: 60rem) {
    .rail {
      display: none;
    }
  }

  .rail__sheet {
    width: 22px;
    height: 5px;
    background: rgba(253, 255, 252, 0.14);
    clip-path: polygon(8% 0%, 100% 12%, 92% 100%, 0% 88%);
    transition: background 0.45s var(--ease-out), transform 0.45s var(--ease-out);
  }

  .rail__sheet.is-active {
    background: var(--c-garnet-bright);
    transform: scaleX(1.35);
  }

  .experience :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .experience__poster {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.8s var(--ease-out);
  }

  .experience__poster.is-retiring {
    opacity: 0;
  }

  .experience__poster-picture {
    position: absolute;
    inset: 0;
  }

  .experience__poster-image {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  .experience__poster::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(2, 5, 3, 0.56) 0%, transparent 56%),
      linear-gradient(180deg, transparent 68%, rgba(2, 5, 3, 0.32) 100%);
  }

  @media (max-width: 60rem) {
    .experience__poster-picture {
      inset: 5.25rem auto auto 50%;
      width: min(118vw, 38rem);
      aspect-ratio: 1;
      transform: translateX(-50%);
      -webkit-mask-image: linear-gradient(
        180deg,
        transparent,
        #000 12%,
        #000 72%,
        transparent
      );
      mask-image: linear-gradient(
        180deg,
        transparent,
        #000 12%,
        #000 72%,
        transparent
      );
      opacity: 0.78;
      mix-blend-mode: screen;
    }

    .experience__poster::after {
      background:
        linear-gradient(90deg, rgba(2, 5, 3, 0.28), transparent 85%),
        linear-gradient(180deg, transparent 30%, rgba(2, 5, 3, 0.48) 67%);
    }
  }

  /* Opening fly-through stage */
  .intro {
    display: none;
  }

  :global(html.has-core) .intro {
    display: block;
    height: 180vh;
    height: 180svh;
    position: relative;
  }

  .intro__cue {
    position: absolute;
    top: calc(100svh - 4.5rem);
    left: 50%;
    transform: translateX(-50%);
    color: var(--c-silver);
    letter-spacing: 0.3em;
  }

  .intro__cue::after {
    content: "";
    position: absolute;
    left: 50%;
    top: calc(100% + 0.9rem);
    width: 1px;
    height: 2.2rem;
    background: linear-gradient(180deg, var(--c-garnet-bright), transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .intro__cue::after {
      animation: cue-drop 2.2s var(--ease-out) infinite;
    }

    @keyframes cue-drop {
      0% {
        transform: scaleY(0.2);
        transform-origin: top;
        opacity: 0;
      }

      45% {
        transform: scaleY(1);
        opacity: 1;
      }

      100% {
        transform: scaleY(1);
        opacity: 0;
      }
    }
  }

  /* Hero */
  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-block: 7rem 2.25rem;
    position: relative;
  }

  :global(html.has-core) .hero {
    /* The hero occupies the intro's final viewport. When the camera cut
       completes at introEnd, the value proposition is already on screen. */
    margin-top: -100vh;
    margin-top: -100svh;
  }

  .hero__content {
    max-width: 46rem;
  }

  .hero__title {
    margin-top: 1.6rem;
  }

  .hero__sub {
    margin-top: 1.75rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .hero__foot {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    border-top: 1px solid var(--c-line);
    padding-top: 1.4rem;
    margin-top: clamp(3rem, 8vh, 5.5rem);
    color: var(--c-faint);
  }

  .hero__foot-list {
    color: var(--c-faint);
  }

  .hero__foot-scroll {
    color: var(--c-faint);
    position: relative;
    padding-right: 1.1rem;
  }

  .hero__foot-scroll::after {
    content: "";
    position: absolute;
    right: 0;
    top: 0.1em;
    width: 1px;
    height: 0.9em;
    background: var(--c-garnet-bright);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__foot-scroll::after {
      animation: scroll-pulse 2.4s var(--ease-out) infinite;
    }

    @keyframes scroll-pulse {
      0%, 100% { transform: scaleY(0.4); opacity: 0.5; }
      50% { transform: scaleY(1); opacity: 1; }
    }
  }

  @media (max-width: 40rem) {
    .hero__foot-list {
      font-size: 0.625rem;
    }
  }

  /* Sections */
  .sec-mark {
    position: absolute;
    top: calc(var(--space-section) - 2.6rem);
    right: var(--gutter);
    color: var(--c-faint);
    font-size: 0.6875rem;
  }

  .sec-mark::after {
    content: "";
    display: inline-block;
    width: 0.65rem;
    height: 1px;
    background: var(--c-garnet-bright);
    margin-left: 0.6rem;
    vertical-align: middle;
  }

  @media (max-width: 48rem) {
    .sec-mark {
      display: none;
    }
  }

  .section-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: var(--space-block);
  }

  .section-foot {
    margin-top: var(--space-block);
  }

  .statement {
    max-width: 24em;
  }

  .statement__facts {
    display: grid;
    gap: 1.75rem;
    margin-top: var(--space-block);
  }

  @media (min-width: 48rem) {
    .statement__facts {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .system-anatomy {
    position: relative;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    margin-top: var(--space-block);
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--c-line);
    overflow: hidden;
    background:
      radial-gradient(90% 120% at 100% 50%, rgba(100, 0, 0, 0.2), transparent 62%),
      color-mix(in srgb, var(--c-bg-raised) 92%, transparent);
  }

  .system-anatomy::before {
    content: "";
    position: absolute;
    width: 0.7rem;
    aspect-ratio: 1;
    top: 1rem;
    right: 1rem;
    background: var(--c-garnet-bright);
    clip-path: polygon(12% 0, 100% 10%, 88% 100%, 0 86%);
  }

  .system-anatomy__intro {
    align-self: center;
    max-width: 26rem;
    color: var(--c-silver);
  }

  .system-anatomy__label {
    margin-bottom: 0.85rem;
    color: var(--c-garnet-text);
  }

  .system-stack {
    list-style: none;
    display: grid;
    gap: 0.45rem;
    padding: 0;
    margin: 0;
  }

  .system-stack li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-items: center;
    min-height: 2.6rem;
    padding: 0.5rem 1rem;
    border: 1px solid color-mix(in srgb, var(--c-porcelain) 12%, transparent);
    color: var(--c-porcelain);
    background: color-mix(
      in srgb,
      var(--c-bg-raised) calc(84% - var(--layer-index) * 3%),
      var(--c-garnet)
    );
    transform: translateX(calc(var(--layer-index) * -0.45rem));
    clip-path: polygon(1.5% 0, 100% 5%, 98.5% 100%, 0 94%);
  }

  .system-stack .numeral {
    font-size: 0.625rem;
  }

  @media (min-width: 48rem) {
    .system-anatomy {
      grid-template-columns: minmax(0, 5fr) minmax(18rem, 7fr);
      align-items: center;
    }
  }

  @media (max-width: 32rem) {
    .system-stack li {
      transform: none;
    }
  }

  /* Services */
  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .svc {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding-block: clamp(1.75rem, 3vw, 2.6rem);
    border-top: 1px solid var(--c-line);
  }

  .svc__num {
    padding-top: 0.55rem;
  }

  .svc__summary {
    margin-top: 0.7rem;
    color: var(--c-silver);
    max-width: 38em;
  }

  .svc__proof {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 1.1rem;
    font-size: var(--text-sm);
    color: var(--c-faint);
    transition: color 0.3s;
  }

  .svc__proof .t-mono {
    color: var(--c-garnet-text);
  }

  .svc__proof:hover,
  .svc__proof:focus-visible {
    color: var(--c-porcelain);
  }

  /* Process */
  .process__intro {
    margin-top: 1.5rem;
  }

  .process-list {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: stage;
  }

  .process-stage {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding-block: 1.75rem;
    border-top: 1px solid var(--c-line);
  }

  .process-stage:first-child {
    border-top: none;
    padding-top: 0;
  }

  .process-stage__title {
    line-height: 1.2;
  }

  .process-stage__desc {
    margin-top: 0.6rem;
    color: var(--c-silver);
    max-width: 36em;
  }

  /* Principles */
  .principles {
    list-style: none;
    margin: var(--space-block) 0 0;
    padding: 0;
    display: grid;
    gap: 2rem;
  }

  .principle {
    border-top: 1px solid var(--c-line);
    padding-top: 1.4rem;
  }

  .principle p {
    margin-top: 0.6rem;
    color: var(--c-silver);
    max-width: 36em;
  }
</style>
