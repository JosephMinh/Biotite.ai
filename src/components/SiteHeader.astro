---
import LogoMark from "./LogoMark.astro";
import { nav, site } from "../data/site";

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname.startsWith(href);
---

<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Biotite Solutions — home">
      <LogoMark size={26} />
      <span class="site-header__wordmark">Biotite<span class="site-header__wordmark-dim">&nbsp;Solutions</span></span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__list" id="primary-nav">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="site-header__link"
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="site-header__cta-item">
          <a href={site.calendly} class="btn" rel="noopener"
            ><span>Book a call</span></a
          >
        </li>
      </ul>
      <button
        class="site-header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="primary-nav"
        data-nav-toggle
      >
        <span class="visually-hidden">Menu</span>
        <span class="site-header__toggle-line" aria-hidden="true"></span>
        <span class="site-header__toggle-line" aria-hidden="true"></span>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    transition: background 0.4s var(--ease-out), border-color 0.4s;
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled {
    background: color-mix(in srgb, var(--c-bg) 82%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--c-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }

  .site-header__wordmark {
    font-family: var(--font-sans);
    font-weight: 550;
    font-size: 1.05rem;
    letter-spacing: 0.01em;
  }

  .site-header__wordmark-dim {
    color: var(--c-silver);
    font-weight: 420;
  }

  .site-header__list {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.5vw, 2.4rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-silver);
    transition: color 0.3s;
    padding-block: 0.5rem;
  }

  .site-header__link:hover,
  .site-header__link:focus-visible {
    color: var(--c-porcelain);
  }

  .site-header__link[aria-current="page"] {
    color: var(--c-porcelain);
    border-bottom: 1px solid var(--c-garnet-bright);
  }

  .site-header__cta-item .btn {
    padding: 0.6rem 1.1rem;
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    width: 2.75rem;
    height: 2.75rem;
    background: none;
    border: 1px solid var(--c-line-strong);
    border-radius: 2px;
    cursor: pointer;
  }

  .site-header__toggle-line {
    display: block;
    width: 1.15rem;
    height: 1.5px;
    background: var(--c-porcelain);
    margin-inline: auto;
    transition: transform 0.35s var(--ease-out);
  }

  @media (max-width: 47.9rem) {
    .site-header__toggle {
      display: flex;
    }

    .site-header__list {
      position: fixed;
      inset: 4.5rem 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.75rem var(--gutter) 2rem;
      background: color-mix(in srgb, var(--c-bg) 94%, transparent);
      -webkit-backdrop-filter: blur(18px);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--c-line);
      display: none;
    }

    .site-header__nav.is-open .site-header__list {
      display: flex;
    }

    .site-header__nav.is-open ~ * {
      /* no-op: overlay handled by fixed positioning */
    }

    .site-header__link {
      display: block;
      padding: 1rem 0;
      font-size: var(--text-sm);
      border-bottom: 1px solid var(--c-line);
      width: 100%;
    }

    .site-header__link[aria-current="page"] {
      border-bottom: 1px solid var(--c-garnet-bright);
    }

    .site-header__cta-item {
      margin-top: 1.25rem;
    }

    .site-header__cta-item .btn {
      width: 100%;
      justify-content: center;
      padding: 1rem;
    }

    .site-header__nav.is-open
      .site-header__toggle
      .site-header__toggle-line:first-child {
      transform: translateY(4.25px) rotate(45deg);
    }

    .site-header__nav.is-open
      .site-header__toggle
      .site-header__toggle-line:last-child {
      transform: translateY(-4.25px) rotate(-45deg);
    }
  }
</style>

<script>
  const header = document.querySelector("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const navEl = toggle?.closest("nav");

  const onScroll = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  toggle?.addEventListener("click", () => {
    const open = navEl?.classList.toggle("is-open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && navEl?.classList.contains("is-open")) {
      navEl.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.focus();
    }
  });
</script>
