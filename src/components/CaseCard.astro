---
import CasePlate from "./CasePlate.astro";
import type { CaseStudy } from "../data/caseStudies";

interface Props {
  study: CaseStudy;
  index: number;
}
const { study, index } = Astro.props;
const num = String(index + 1).padStart(2, "0");
---

<article class:list={["case-card", { "case-card--flip": index % 2 === 1 }]} data-reveal>
  <a href={`/work/${study.slug}/`} class="case-card__link">
    <div class="case-card__media">
      {study.coverImage ? (
        <img
          src={study.coverImage}
          alt={study.coverAlt ?? ""}
          width="1600"
          height="696"
          loading="lazy"
          decoding="async"
          class="case-card__image"
        />
      ) : (
        <CasePlate variant={study.plate} class="case-card__plate" />
      )}
    </div>
    <div class="case-card__body">
      <p class="case-card__meta">
        <span class="numeral">{num}</span>
        <span class="case-card__industry">{study.industry}</span>
      </p>
      <h3 class="case-card__title t-display t-xl">{study.title}</h3>
      <p class="case-card__summary">{study.shortSummary}</p>
      <ul class="case-card__tags" aria-label="Services">
        {study.services.map((s) => <li class="tag">{s}</li>)}
      </ul>
      <span class="link-arrow case-card__cta">
        Read the case study
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      </span>
    </div>
  </a>
</article>

<style>
  .case-card {
    border-top: 1px solid var(--c-line);
  }

  .case-card__link {
    display: grid;
    gap: 1.75rem;
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }

  @media (min-width: 60rem) {
    .case-card__link {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2rem, 5vw, 5rem);
      align-items: center;
    }

    .case-card--flip .case-card__link {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .case-card--flip .case-card__media {
      order: 2;
    }
  }

  .case-card__media {
    aspect-ratio: 8 / 5;
  }

  .case-card__media :global(.plate) {
    height: 100%;
    transition: border-color 0.5s var(--ease-out);
  }

  .case-card__media :global(svg) {
    transition: transform 1.1s var(--ease-out);
  }

  .case-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--c-line);
    filter: saturate(0.78) contrast(1.08) brightness(0.78);
    transition:
      transform 1.1s var(--ease-out),
      filter 0.6s var(--ease-out),
      border-color 0.5s var(--ease-out);
  }

  .case-card__link:hover .case-card__media :global(.plate) {
    border-color: var(--c-line-strong);
  }

  .case-card__link:hover .case-card__image {
    filter: saturate(0.9) contrast(1.04) brightness(0.9);
    border-color: var(--c-line-strong);
  }

  @media (prefers-reduced-motion: no-preference) {
    .case-card__link:hover .case-card__media :global(svg),
    .case-card__link:hover .case-card__image {
      transform: scale(1.03);
    }
  }

  .case-card__meta {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .case-card__industry {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-faint);
  }

  .case-card__title {
    max-width: 18em;
    transition: color 0.4s;
  }

  .case-card__summary {
    margin-top: 1rem;
    color: var(--c-silver);
    max-width: 36em;
  }

  .case-card__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 1.4rem 0 0;
  }

  .case-card__cta {
    margin-top: 1.6rem;
  }

  .case-card__link:hover .case-card__cta {
    color: var(--c-porcelain);
  }

  .case-card__link:hover .case-card__cta svg {
    transform: translateX(4px);
  }
</style>
